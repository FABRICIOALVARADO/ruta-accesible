PORT=3001
FASTAPI_DATABASE_PATH=data/ruta-accesible-fastapi.db
LEGACY_DATABASE_PATH=data/ruta-accesible.db

# Clave para el navegador. Se configura localmente.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Cuenta administradora inicial. Usa una contraseña propia de 12 caracteres o más.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional para servir detrás de un proxy HTTPS.
# APP_ORIGIN=https://tu-dominio.example
# SECURE_COOKIE=1
